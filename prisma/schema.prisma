generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  CUSTOMER
}

enum ProductCategory {
  PARFUM
  ACCESSOIRE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String?
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model LoginAttempt {
  identifier      String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  category    ProductCategory  @default(PARFUM)
  description String
  story       String
  images      String[]
  notesTop    String[]
  notesHeart  String[]
  notesBase   String[]
  isActive    Boolean          @default(false)
  variants    ProductVariant[]
  orderItems  OrderItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, category, createdAt])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  volume    String
  price     Int
  stock     Int     @default(0)
  isActive  Boolean @default(true)

  @@unique([productId, volume])
}

model Order {
  id              String        @id @default(cuid())
  // Référence lisible communiquée au client (ex. « JAE-7K3P9Q ») : c'est elle
  // qu'il indique dans son message de paiement Lydia.
  reference       String?       @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  // Montants en centimes : sous-total articles + livraison = total.
  subtotalAmount  Int           @default(0)
  shippingAmount  Int           @default(0)
  totalAmount     Int
  currency        String        @default("eur")
  status          OrderStatus   @default(PENDING)
  stripeSessionId String?       @unique
  paymentStatus   PaymentStatus @default(UNPAID)
  deliveryAddress Json
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
  @@index([email])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  volume    String
  quantity  Int
  price     Int

  @@index([orderId])
  @@index([productId])
}

// Image téléversée depuis l'espace admin, servie via /api/media/[id].
// Stockée en base (bytea) : aucun stockage externe à configurer.
model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Réglages du site modifiables depuis l'admin (images de la page d'accueil…).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model Ambassador {
  id          String   @id @default(cuid())
  name        String
  role        String   @default("")
  photo       String
  description String
  instagram   String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Store {
  id           String   @id @default(cuid())
  name         String
  address      String
  city         String
  country      String
  phone        String?
  openingHours String
  image        String
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum ApplicationStatus {
  NEW
  CONTACTED
  ACCEPTED
  REJECTED
}

// Candidatures « Devenir ambassadrice » envoyées depuis le site public.
model AmbassadorApplication {
  id        String            @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  instagram String?
  city      String?
  message   String
  status    ApplicationStatus @default(NEW)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, createdAt])
}

// Inscriptions au « Cercle JAE » (newsletter de la page d'accueil).
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Limiteur de débit partagé entre toutes les instances serverless (Vercel) :
// un compteur par clé (portée + empreinte de l'IP) sur une fenêtre fixe.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}
