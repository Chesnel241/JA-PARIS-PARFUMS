# Base de données PostgreSQL
POSTGRES_DB="jae_paris"
POSTGRES_USER="jae_user"
POSTGRES_PASSWORD="change-this-local-password"
DATABASE_URL="postgresql://jae_user:change-this-local-password@localhost:5432/jae_paris?schema=public"

# Auth.js (NextAuth v5)
# Générer avec : openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-secret-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Administrateur initial (seeder)
ADMIN_EMAIL="admin@jae-paris.com"
ADMIN_PASSWORD="choose-a-strong-password-of-at-least-12-characters"

# Paiement par carte : Stripe Checkout, seul moyen de paiement (voir README ›
# Paiement par carte). Sans STRIPE_SECRET_KEY, aucune commande n'est possible.
# Local / préproduction : clés de TEST uniquement. Ne jamais committer de vraie clé.
STRIPE_SECRET_KEY=""
# Secret de signature du webhook https://<domaine>/api/stripe/webhook
# (en local : `stripe listen --forward-to localhost:3000/api/stripe/webhook`).
STRIPE_WEBHOOK_SECRET=""
# Stripe Tax : "true" seulement après avoir renseigné siège et immatriculations.
STRIPE_AUTOMATIC_TAX="false"
# Code taxe produit facultatif (txcd_… de la liste officielle Stripe).
STRIPE_TAX_CODE=""
# Tests uniquement : API Stripe simulée (`npm run stripe:mock`). Ignorée avec
# une clé live. Laisser vide en production.
STRIPE_API_BASE=""

# URL publique du site (utilisée pour les redirections et emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
